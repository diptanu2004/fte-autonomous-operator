# CLI defaults (the Streamlit app takes these from the sidebar instead)
FTE_PROVIDER=ollama            # ollama | lmstudio | groq | custom
FTE_MODEL=qwen3:30b-a3b        # groq: qwen/qwen3-32b
# FTE_BASE_URL=http://localhost:11434/v1
# FTE_API_KEY=                 # or GROQ_API_KEY for provider=groq
FTE_THINKING=0

# Ollama: give Qwen3 enough context (the agent's prompts are ~5-8k tokens)
OLLAMA_CONTEXT_LENGTH=16384

# Override demo credentials without editing company/systems.yaml
# FTE_SECRET_PORTAL_PASSWORD=...
